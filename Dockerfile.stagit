FROM alpine:3.19

# ==========================================
# Build dependencies
# ==========================================

RUN apk add --no-cache \
    make \
    gcc \
    musl-dev \
    libgit2-dev \
    git \
    pkgconf \
    cairo-dev \
    pango-dev \
    bash \
    gawk \
    wget

WORKDIR /src

# ==========================================
# Build Stagit
# ==========================================

RUN wget https://codemadness.org/releases/stagit/stagit-1.2.tar.gz

# Checksum verification
RUN echo "5659bd8ba7e1417edd40f7b7781a8ea26939ab6aa513409023835f04875921c5  stagit-1.2.tar.gz" \
    | sha256sum -c -

# Extract and compile Stagit
RUN tar -xzf stagit-1.2.tar.gz && \
    cd stagit-1.2 && \
    make && \
    make install

# ==========================================
# Install Grawkit
# ==========================================

RUN git clone https://github.com/deuill/grawkit.git && \
    cd grawkit && \
    chmod +x grawkit && \
    cp grawkit /usr/local/bin/

# ==========================================
# Setup Container Runtime
# ==========================================

WORKDIR /app

COPY build-git.sh .
COPY graph.txt .

# Copy repository configuration
COPY repos.conf .

RUN chmod +x build-git.sh

# ==========================================
# Runtime
# ==========================================

CMD ["./build-git.sh"]